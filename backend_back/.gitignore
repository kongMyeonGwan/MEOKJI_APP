# 사람마다 다른 값이 들어가는 설정. application-local.yml.example 을 복사해서 쓴다.
application-local.yml

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# IDE
.idea/
*.iml
# IntelliJ 가 빌드할 때 만드는 폴더 (Gradle 의 build/ 와 같은 성격)
out/
# gradlew idea 가 만드는 프로젝트 파일 (Gradle Sync 를 못 쓰는 옛 IDE 용)
*.ipr
*.iws
# gradlew copyDeps 가 모으는 의존성 jar (IDE 수동 설정용, 50MB)
libs/
.vscode/
.classpath
.project
.settings/
bin/

# 후기 첨부파일. 파일 본체는 DB 가 아니라 디스크에 저장한다.
# 사람이 올린 사진이라 저장소에 넣을 것이 아니고, 팀원마다 내용이 달라 충돌만 난다.
uploads/

# 떨이 재료를 훑어둔 결과 (app.price.bargain-file). 서버가 KAMIS 를 훑어 남기는 캐시라
# 날마다 바뀌고, 없으면 서버가 다시 만든다.
data/bargains.json
