<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- DB 연결 확인. namespace 는 짝이 되는 DAO 인터페이스의 전체 이름이다 -->
<mapper namespace="com.meokji.api.health.dao.HealthDAO">

    <!-- id 는 DAO 의 메서드 이름과 같아야 한다. 오라클은 FROM 이 꼭 필요해서 DUAL 을 쓴다 -->
    <select id="ping" resultType="int">
        SELECT 1 FROM DUAL
    </select>

</mapper>
