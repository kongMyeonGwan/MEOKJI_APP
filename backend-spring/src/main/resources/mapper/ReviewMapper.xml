<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  RECIPE_REVIEWS 테이블 SQL (커뮤니티 게시글). namespace 는 짝이 되는 DAO 의 전체 이름이다.
  TODO(게시판 담당): 목록 · 개수 · 작성 · 수정 · 삭제 · 댓글 · 좋아요 SQL 을 더 만든다.
  페이지 목록 예시는 HistoryMapper.xml 의 findPageByUser 를 참고한다.
-->
<mapper namespace="com.meokji.api.dao.ReviewDAO">

    <select id="findById" resultType="com.meokji.api.vo.RecipeReviewVO">
        SELECT id, user_id, meal_history_id, title, content, view_count, use_yn,
               file_yn, file_name, file_org_name, file_path, file_ext, file_size,
               created_at, updated_at
          FROM recipe_reviews
         WHERE id = #{id}
    </select>

</mapper>
