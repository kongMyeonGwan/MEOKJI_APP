# env / secrets
.env
.env.local
*.env
# .env.bak · .env~ · .env.save 처럼 뒤에 뭐가 붙은 것도 전부 막는다.
# *.env 는 "이름이 .env 로 끝나는 것" 이라 .env.bak 을 안 거른다.
# 편집기가 만드는 백업 파일에도 키가 그대로 들어 있다.
# (.env.example 은 바로 아래에서 다시 꺼낸다)
.env*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# node
node_modules/
dist/
.vite/

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs
*.log

# 실수로 하위 폴더에 다시 클론된 중첩 저장소 (자체 .git 보유)
MEOKJI_APP/

# 후기 첨부파일 (backend/.env 의 UPLOAD_DIR)
# 파일 본체는 DB 가 아니라 디스크에 저장한다. 사람이 올린 사진이라
# 저장소에 넣을 것이 아니고, 팀원마다 내용이 달라 충돌만 난다.
backend/uploads/

# 시세 훑기 캐시 (backend/app/services/bargain_service.py 가 스스로 쓴다)
# 사람이 적는 값이 아니라 서버가 KAMIS 를 훑어 남기는 캐시다. 훑은 날짜가
# 팀원마다 달라 충돌만 나고, 없으면 서버가 다시 만든다.
# 같은 폴더의 catalog.json 은 사람이 적는 고정 목록이라 추적한다.
backend/app/data/bargains.json
