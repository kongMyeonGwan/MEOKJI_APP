# env / secrets
.env
.env.local
*.env
# .env.bak · .env~ · .env.save 처럼 뒤에 뭐가 붙은 것도 전부 막는다.
# *.env 는 "이름이 .env 로 끝나는 것" 이라 .env.bak 을 안 거른다.
# 편집기가 만드는 백업 파일에도 키가 그대로 들어 있다.
# (.env.example 은 바로 아래에서 다시 꺼낸다)
.env*
!.env.example

# node
node_modules/
dist/
.vite/

# editor / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# 이클립스(STS) 작업공간 폴더. 프로젝트를 이클립스로 한 번 열면 생긴다.
# 로그 · 잠금파일 · 창 배치 같은 내 PC 사정이라 사람마다 다르고, 안에
# 압축된 바이너리가 수백 개 들어 있어 올리면 받는 쪽 작업공간을 덮어쓴다.
backend/.metadata/

# logs
*.log

# 실수로 하위 폴더에 다시 클론된 중첩 저장소 (자체 .git 보유)
MEOKJI_APP/

# 옛 백엔드 찌꺼기. 지금 backend/ 는 스프링 서버인데, 예전 backend/ 폴더를 안 지운
# PC 에서는 그 실행 환경 · 캐시가 같은 폴더에 섞여 남는다. 스프링 구조(src/)와
# 겹치지 않는 이름만 막는다. (코드는 git 기록에만 있다 - 8597a9a 에서 걷어냄)
backend/.venv/
backend/.pytest_cache/
backend/app/
backend/tests/

# Git Bash 가 비정상 종료할 때 떨어뜨리는 크래시 덤프
# 코드도 설정도 아니고, 그날 셸이 한 번 죽었다는 흔적일 뿐이다.
# 규칙이 없어서 한 번 커밋에 실려 들어간 적이 있다.
*.stackdump
