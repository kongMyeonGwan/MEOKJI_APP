# =========================================================
# 뭐먹지? Backend 환경변수 템플릿
# 이 파일은 git에 커밋됩니다. 실제 값은 .env 에만 넣으세요.
# 사용법: cp .env.example .env  후 값을 채우세요.
# =========================================================

# ===== App =====
APP_ENV=local
DEBUG=true

# ===== Database (Oracle 21c XE / 팀 공용) =====
# 네트워크가 바뀌면 DB_HOST 한 줄만 수정하면 됩니다.
DB_HOST=10.1.54.120
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=meokji_app
DB_PASSWORD=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# ===== JWT (Access Token만 사용, Refresh Token 없음) =====
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== 계정 잠금 / OTP =====
MAX_LOGIN_FAIL_COUNT=20
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPT=5

# 인증번호 재발송 최소 간격(초). 연타로 남의 받은편지함을 채우는 것을 막는다.
# OTP_EXPIRE_MINUTES 보다 짧아야 한다 — 길면 만료된 뒤에도 새로 못 받는다.
OTP_RESEND_COOLDOWN_SECONDS=60

# ===== CORS (쉼표로 여러 개) =====
CORS_ORIGINS=http://localhost:5173

# ===== Email (STEP 8) =====
# mock : 실제로 보내지 않고 서버 콘솔에 인증번호를 출력 (개발용)
# smtp : 실제 발송
EMAIL_PROVIDER=mock
# 네이버 : smtp.naver.com / Gmail : smtp.gmail.com
SMTP_HOST=
# 587=STARTTLS(권장), 465=SSL
SMTP_PORT=587
# 로그인 계정 (네이버는 @naver.com 앞의 아이디만, Gmail은 전체 주소)
SMTP_USER=
# 계정 비밀번호가 아니라 앱 비밀번호를 발급받아 넣는다
SMTP_PASSWORD=
# 보내는 사람 주소. 비우면 SMTP_USER를 사용
SMTP_FROM=

# ===== AI (STEP 10~11) =====
# catalog 하나뿐이다. 기본값이라 적지 않아도 된다.
# (예전 이름이 mock 이고 지금도 그 값을 받아주지만, 새로 적을 때는 catalog)
#
# catalog 는 "가짜" 가 아니라 "AI 없이" 라는 뜻이다.
#
#   음식 추천   카탈로그 100종에 날씨·Ban·냉장고 점수를 매겨 고른다
#   레시피      미리 써둔 100종 레시피에서 꺼낸다 (app/data/recipes.json)
#   날씨        영향 없음. WEATHER_PROVIDER 가 따로 정한다 (실제 API 그대로)
#   재료 가격    영향 없음. PRICE_PROVIDERS 가 따로 정한다 (KAMIS 실측 그대로)
#AI_PROVIDER=catalog

# --- 제미나이 · 클로드는 쓰지 않는다 (2026-09-26) ---
# 요리와 레시피가 모두 미리 써둔 파일에서 나오므로 AI 를 부를 자리가 없다.
# 코드는 지우지 않고 주석으로 남겨뒀다 (app/integrations/ai_api.py ·
# app/core/config.py · requirements.txt). 다시 켤 때 그 셋과 아래를 같이 푼다.
#
#GEMINI_API_KEY=
#GEMINI_MODEL=gemini-3.8-flash,gemini-3.7-flash
#ANTHROPIC_API_KEY=
#AI_MODEL=claude-opus-5

# ===== Weather (STEP 12) =====
WEATHER_PROVIDER=mock
OPENWEATHER_API_KEY=

# ===== 재료 가격 (STEP 17~19) =====
# kamis : 공공데이터포털 KAMIS 일별 도·소매 가격정보 조회
#
# 네이버 쇼핑 검색 API 는 2026-07-31 종료됐고 공식 대체가 없다.
# 쿠팡·11번가는 제휴 승인이 필요해서 지금은 못 쓴다.
#
# kamis 는 농수산물만 조사한다. 두부·간장 같은 가공식품은 값이 없고,
# 화면에 '가격 정보 없음'으로 나간다. 값을 지어내지 않는다.
PRICE_PROVIDERS=kamis

# 공공데이터포털 마이페이지 > 일반 인증키(Decoding 값)
# ※ Encoding 값(%2B %3D%3D 가 섞인 쪽)을 넣으면 httpx 가 한 번 더 인코딩해서
#    SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다. 반드시 Decoding 쪽을 넣을 것.
DATA_GO_KR_SERVICE_KEY=


# ===== 후기 첨부파일 (STEP 26) =====
# 파일 본체는 DB 에 넣지 않는다. 아래 폴더에 저장하고 DB 에는 경로만 적는다.
# 값을 안 적어도 아래 기본값으로 동작한다 — 키가 필요 없는 기능이다.
#
# UPLOAD_DIR 은 상대 경로면 backend 폴더 기준이다.
# 이 폴더는 .gitignore 에 들어 있어 커밋되지 않는다.
UPLOAD_DIR=uploads

# 한 파일의 최대 크기(MB)
UPLOAD_MAX_MB=5

# 받아줄 확장자. "허용한 것만 받는다" 로 적는다 —
# 금지 목록 방식은 빠뜨린 하나가 곧 구멍이 된다.
UPLOAD_ALLOWED_EXTS=jpg,jpeg,png,gif,webp
