# =========================================================
# 뭐먹지? Backend 환경변수 템플릿
# 이 파일은 git에 커밋됩니다. 실제 값은 .env 에만 넣으세요.
# 사용법: cp .env.example .env  후 값을 채우세요.
# =========================================================

# ===== App =====
APP_ENV=local
DEBUG=true

# ===== Database (Oracle 21c XE / 팀 공용) =====
# 네트워크가 바뀌면 DB_HOST 한 줄만 수정하면 됩니다.
DB_HOST=10.1.54.120
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=meokji_app
DB_PASSWORD=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# ===== JWT (Access Token만 사용, Refresh Token 없음) =====
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== 계정 잠금 / OTP =====
MAX_LOGIN_FAIL_COUNT=20
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPT=5

# ===== CORS (쉼표로 여러 개) =====
CORS_ORIGINS=http://localhost:5173

# ===== Email (STEP 8) =====
# mock : 실제로 보내지 않고 서버 콘솔에 인증번호를 출력 (개발용)
# smtp : 실제 발송
EMAIL_PROVIDER=mock
# 네이버 : smtp.naver.com / Gmail : smtp.gmail.com
SMTP_HOST=
# 587=STARTTLS(권장), 465=SSL
SMTP_PORT=587
# 로그인 계정 (네이버는 @naver.com 앞의 아이디만, Gmail은 전체 주소)
SMTP_USER=
# 계정 비밀번호가 아니라 앱 비밀번호를 발급받아 넣는다
SMTP_PASSWORD=
# 보내는 사람 주소. 비우면 SMTP_USER를 사용
SMTP_FROM=

# ===== AI (STEP 10~11) =====
# mock   : API 키 없이 카탈로그에서 골라준다 (키가 없어도 화면 전체가 돈다)
# gemini : Google Gemini  — 무료 등급이 있다
# claude : Anthropic Claude — 유료(선불 크레딧)
AI_PROVIDER=mock

# --- Gemini : https://aistudio.google.com 에서 발급 ---
GEMINI_API_KEY=
# 쉼표로 여러 개. 앞에서부터 시도하고, 모델이 붐비면(503) 다음 모델로 넘어간다.
# 무료 등급은 붐비는 일이 잦아서 예비 모델을 하나 적어두는 편이 좋다.
GEMINI_MODEL=gemini-3.7-flash,gemini-3.5-flash

# --- Claude : https://console.anthropic.com 에서 발급 ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ===== Weather (STEP 12) =====
WEATHER_PROVIDER=mock
OPENWEATHER_API_KEY=

# ===== 재료 가격 (STEP 17~19) =====
# kamis : 공공데이터포털 KAMIS 일별 도·소매 가격정보 조회
#
# 네이버 쇼핑 검색 API 는 2026-07-31 종료됐고 공식 대체가 없다.
# 쿠팡·11번가는 제휴 승인이 필요해서 지금은 못 쓴다.
#
# kamis 는 농수산물만 조사한다. 두부·간장 같은 가공식품은 값이 없고,
# 화면에 '가격 정보 없음'으로 나간다. 값을 지어내지 않는다.
PRICE_PROVIDERS=kamis

# 공공데이터포털 마이페이지 > 일반 인증키(Decoding 값)
# ※ Encoding 값(%2B %3D%3D 가 섞인 쪽)을 넣으면 httpx 가 한 번 더 인코딩해서
#    SERVICE_KEY_IS_NOT_REGISTERED_ERROR 가 난다. 반드시 Decoding 쪽을 넣을 것.
DATA_GO_KR_SERVICE_KEY=
