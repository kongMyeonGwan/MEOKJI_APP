# =========================================================
# 뭐먹지? Backend 환경변수 템플릿
# 이 파일은 git에 커밋됩니다. 실제 값은 .env 에만 넣으세요.
# 사용법: cp .env.example .env  후 값을 채우세요.
# =========================================================

# ===== App =====
APP_ENV=local
DEBUG=true

# ===== Database (Oracle 21c XE / 팀 공용) =====
# 네트워크가 바뀌면 DB_HOST 한 줄만 수정하면 됩니다.
DB_HOST=10.1.54.120
DB_PORT=1521
DB_SERVICE=XEPDB1
DB_USER=meokji_app
DB_PASSWORD=
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5


# ===== JWT (Access Token만 사용, Refresh Token 없음) =====
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# ===== 계정 잠금 / OTP =====
MAX_LOGIN_FAIL_COUNT=20
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPT=5

# ===== CORS (쉼표로 여러 개) =====
CORS_ORIGINS=http://localhost:5173

# ===== Email (STEP 8) =====
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ===== AI (STEP 10) =====
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ===== Weather (STEP 12) =====
WEATHER_PROVIDER=mock
OPENWEATHER_API_KEY=

# ===== Shopping (STEP 17, 쉼표로 여러 개) =====
PRICE_PROVIDERS=mock
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
