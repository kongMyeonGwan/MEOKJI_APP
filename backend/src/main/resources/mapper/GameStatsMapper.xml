<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.meokji.api.game.dao.GameStatsDAO">

    <select id="selectPlayCounts" resultType="com.meokji.api.game.vo.GameStatVO">
        SELECT game_type, COUNT(*) AS plays
        FROM   game_histories
        GROUP  BY game_type
    </select>

</mapper>
