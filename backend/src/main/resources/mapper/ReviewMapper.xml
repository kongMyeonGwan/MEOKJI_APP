<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  RECIPE_REVIEWS 테이블 SQL (커뮤니티 게시글). namespace 는 짝이 되는 DAO 의 전체 이름이다.
  TODO(게시판 담당): 목록 · 개수 · 작성 · 수정 · 삭제 · 댓글 · 좋아요 SQL 을 더 만든다.
  페이지 목록 예시는 HistoryMapper.xml 의 findPageByUser 를 참고한다.
-->
<mapper namespace="com.meokji.api.review.dao.ReviewDAO">

    <!--
      글 한 행 + 첨부. FILE_* 다섯 칸을 글 바로 밑이 아니라 file 안에 담는다.
      같은 값을 RecipeReviewVO 와 ReviewFileVO 두 군데 두지 않기 위해서다.

      autoMapping="true" 라 나머지 칸(title · view_count ...)은 이름만 맞으면
      알아서 들어간다. 여기 적는 것은 이름이 안 맞는 다섯 칸뿐이다.

      file_yn 은 association 에 넣지 않는다. 그 칸은 NOT NULL 이라 첨부가
      없어도 'N' 이 들어 있는데, association 에 섞으면 "값이 하나라도 있다"
      가 되어 빈 file 객체가 만들어진다. 다섯 칸만 두면 첨부가 없을 때
      전부 NULL 이라 MyBatis 가 file 을 null 로 둔다 — 화면이 기다리는 모양이다.

      (돌아가는 본보기: FreePostMapper.xml 의 postWithFile)
    -->
    <resultMap id="reviewWithFile" type="com.meokji.api.review.vo.RecipeReviewVO" autoMapping="true">
        <id property="id" column="id"/>
        <association property="file" javaType="com.meokji.api.review.vo.ReviewFileVO">
            <result property="savedName" column="file_name"/>
            <result property="path"      column="file_path"/>
            <result property="name"      column="file_org_name"/>
            <result property="ext"       column="file_ext"/>
            <result property="size"      column="file_size"/>
        </association>
    </resultMap>

    <select id="findById" resultMap="reviewWithFile">
        SELECT id, user_id, meal_history_id, title, content, view_count, use_yn,
               file_yn, file_name, file_org_name, file_path, file_ext, file_size,
               created_at, updated_at
          FROM recipe_reviews
         WHERE id = #{id}
    </select>

</mapper>
