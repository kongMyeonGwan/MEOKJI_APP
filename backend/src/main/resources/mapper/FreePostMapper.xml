<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  FREE_POSTS 표 SQL (자유게시판 글). namespace 는 짝이 되는 DAO 의 전체 이름이다.
  표 정의는 db/01_schema.sql 의 11번, db/09_add_free_posts.sql 에 있다.
-->
<mapper namespace="com.meokji.api.free.dao.FreePostDAO">

    <!--
      검색 조건. 개수와 목록이 이 조각을 같이 쓴다 - 따로 적으면
      한쪽만 고치는 실수가 난다.

      keyword 는 LIKE 로 찾는다. 대소문자를 가리지 않게 양쪽을 LOWER 로 내린다.
      content 는 CLOB 이라 LIKE 가 되지만 느리다. 글이 많아지면 제목만
      찾도록 줄이거나 오라클 텍스트 색인을 붙이는 것이 맞다.
    -->
    <sql id="searchWhere">
         WHERE p.use_yn = 'Y'
        <if test="keyword != null and keyword != ''">
           AND (LOWER(p.title) LIKE '%' || LOWER(#{keyword}) || '%'
                OR LOWER(p.content) LIKE '%' || LOWER(#{keyword}) || '%')
        </if>
    </sql>

    <select id="count" resultType="int">
        SELECT COUNT(p.id)
          FROM free_posts p
        <include refid="searchWhere"/>
    </select>

    <!--
      OFFSET ... ROWS FETCH NEXT ... 는 오라클 12c 부터 쓸 수 있다. 21c XE 라 문제없다.
      ROWNUM 으로 자르면 정렬 전에 매겨져서 아무 행이나 나온다.

      DBMS_LOB.SUBSTR 로 본문 앞 200자만 가져온다. 목록에 본문 전체를 실어
      보내면 글이 길어질수록 응답이 통째로 무거워지는데, 화면은 두 줄만 쓴다.
      (CLOB 을 그냥 자를 수 없어서 오라클 함수를 쓴다)

      상세와 같은 FreePostVO 에 담지만 고르는 칸이 다르다. 여기서 안 고른
      칸(comments · file · is_mine)은 null 로 남고 화면도 쓰지 않는다.

      created_at 을 TO_CHAR 로 바꾸지 않는다. VO 의 칸이 LocalDateTime 이라
      문자열을 담으려 하면 매핑에서 터진다. 응답용 문자열로 바꾸는 일은
      FreePostVO.getCreatedAtText() 가 한다.

      file_yn 을 그대로 가져온다. 화면이 읽는 has_file 은 그 값을 보고
      FreePostVO.getHasFile() 이 만든다.

      댓글 수는 스칼라 서브쿼리로 센다. 컬럼으로 들고 있으면 댓글을 지웠을 때
      같이 줄이는 것을 잊어 조용히 어긋난다.
    -->
    <select id="findPage" resultType="com.meokji.api.free.vo.FreePostVO">
        SELECT p.id,
               p.title,
               DBMS_LOB.SUBSTR(p.content, 200, 1) AS content,
               u.nickname,
               p.view_count,
               p.created_at,
               p.file_yn,
               (SELECT COUNT(c.id)
                  FROM post_comments c
                 WHERE c.board_type = 'F'
                   AND c.post_id = p.id
                   AND c.use_yn = 'Y')          AS comment_count
          FROM free_posts p
          JOIN users u ON u.id = p.user_id
        <include refid="searchWhere"/>
         ORDER BY p.created_at DESC, p.id DESC
         OFFSET #{offset} ROWS FETCH NEXT #{size} ROWS ONLY
    </select>

    <!--
      글 한 행 + 첨부. FILE_* 다섯 칸을 글 바로 밑이 아니라 file 안에 담는다.

      autoMapping="true" 라 나머지 칸(title · view_count · nickname ...)은
      여태처럼 이름만 맞으면 알아서 들어간다. 여기 적는 것은 이름이
      안 맞는 다섯 칸뿐이다.

      file_yn 은 association 에 넣지 않는다. 그 칸은 NOT NULL 이라 첨부가
      없어도 'N' 이 들어 있는데, association 에 섞으면 "값이 하나라도 있다"
      가 되어 빈 file 객체가 만들어진다. 다섯 칸만 두면 첨부가 없을 때
      전부 NULL 이라 MyBatis 가 file 을 null 로 둔다 — 화면이 기다리는 모양이다.
    -->
    <resultMap id="postWithFile" type="com.meokji.api.free.vo.FreePostVO" autoMapping="true">
        <id property="id" column="id"/>
        <association property="file" javaType="com.meokji.api.free.vo.FreeFileVO">
            <result property="savedName" column="file_name"/>
            <result property="path"      column="file_path"/>
            <result property="name"      column="file_org_name"/>
            <result property="ext"       column="file_ext"/>
            <result property="size"      column="file_size"/>
        </association>
    </resultMap>

    <select id="findById" resultMap="postWithFile">
        SELECT p.id, p.user_id, p.title, p.content,
               p.file_yn, p.file_name, p.file_org_name, p.file_path, p.file_ext, p.file_size,
               p.view_count, p.use_yn, p.created_at, p.updated_at,
               u.nickname
          FROM free_posts p
          JOIN users u ON u.id = p.user_id
         WHERE p.id = #{id}
    </select>

    <!--
      글쓰기 · 글 수정 · 글 삭제 SQL 은 여기 없다. JPA 가 맡는다.
      (free/entity/FreePostEntity + free/repository/FreePostRepository)

      JPA 쪽도 같은 일을 한다 - id 는 오라클 IDENTITY 가 채우고, 삭제는
      행을 지우지 않고 use_yn='N' 으로 바꾸며, 시각은 UTC 로 적는다.
      옛 SQL 은 git 기록에 있다.
    -->

    <update id="increaseView">
        UPDATE free_posts
           SET view_count = view_count + 1
         WHERE id = #{id}
           AND use_yn = 'Y'
    </update>

    <select id="findViewCount" resultType="int">
        SELECT view_count
          FROM free_posts
         WHERE id = #{id}
    </select>

    <!--
      첨부 정보를 한 문장으로 바꾼다. 나눠서 UPDATE 하면 중간 상태가
      ck_free_posts_file_set 제약에 걸린다 (file_yn='Y' 인데 경로가 빈 행 금지).
    -->
    <update id="setFile" parameterType="com.meokji.api.free.vo.FreePostVO">
        UPDATE free_posts
           SET file_yn = 'Y',
               file_name = #{file.savedName},
               file_org_name = #{file.name},
               file_path = #{file.path},
               file_ext = #{file.ext},
               file_size = #{file.size},
               updated_at = SYS_EXTRACT_UTC(SYSTIMESTAMP)
         WHERE id = #{id}
    </update>

    <update id="clearFile">
        UPDATE free_posts
           SET file_yn = 'N',
               file_name = NULL,
               file_org_name = NULL,
               file_path = NULL,
               file_ext = NULL,
               file_size = NULL,
               updated_at = SYS_EXTRACT_UTC(SYSTIMESTAMP)
         WHERE id = #{id}
    </update>

</mapper>
